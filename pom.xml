		<!--
		  The engine. Shaded into this jar, relocated, and never installed by
		  the user as a separate artifact — see the shade plugin below.

		  Compile scope but NOT `provided`: the class files must end up inside
		  the shipped jar, because a bare Fiji has never heard of volcoloc-core
		  and the whole point of the pattern is that it never has to.
		-->
		<dependency>
			<groupId>io.github.jay2owe</groupId>
			<artifactId>volcoloc-core</artifactId>
			<version>0.1.0</version>
		</dependency>

		<!-- Shared ROI/label ingest, regex grouping, and dialog widgets. -->
		<dependency>
			<groupId>io.github.jay2owe</groupId>
			<artifactId>oc3d-core</artifactId>
			<version>0.1.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<!-- Both cores are shaded; users install this jar alone. -->
							<addClasspath>false</addClasspath>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<!--
			  Shade volcoloc-core into this jar, relocated.

			  The pattern rule: the user installs ONE jar on a bare Fiji and
			  never learns a core exists. Relocation is not optional — under
			  Fiji's flat classloader, two jars carrying the same
			  fully-qualified class name is a silent-wrong-answer bug, not a
			  crash, and 3D Objects Counter+ will ship its own copy of this
			  same engine.

			  Verified before enabling: no Class.forName, no loadClass, no
			  reflection anywhere in either module, so there are no strings for
			  relocation to miss. plugins.config names
			  volcoloc.Volumetric_Colocalization, which is not relocated.

			  artifactSet is an explicit allow-list. net.imagej:ij must never be
			  bundled: it is what Fiji already is.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>true</createDependencyReducedPom>
							<artifactSet>
								<includes>
									<include>io.github.jay2owe:volcoloc-core</include>
									<include>io.github.jay2owe:oc3d-core</include>
								</includes>
							</artifactSet>
							<relocations>
								<relocation>
									<pattern>sc.fiji.volcoloc.core</pattern>
									<shadedPattern>volcoloc.internal.volcoloc</shadedPattern>
								</relocation>
								<relocation>
									<pattern>sc.fiji.oc3d.core</pattern>
									<shadedPattern>volcoloc.internal.core</shadedPattern>
								</relocation>
							</relocations>
							<filters>
								<filter>
									<artifact>io.github.jay2owe:volcoloc-core</artifact>
									<excludes>
										<exclude>META-INF/MANIFEST.MF</exclude>
										<exclude>META-INF/maven/**</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>io.github.jay2owe:oc3d-core</artifact>
									<excludes>
										<exclude>META-INF/MANIFEST.MF</exclude>
										<exclude>META-INF/maven/**</exclude>
									</excludes>
								</filter>
							</filters>
							<!--
							  Only the chassis classes this plugin actually
							  reaches are worth carrying. minimizeJar drops the
							  rest, which is most of oc3d-core: the labeller,
							  the measurement and map builders and the batch
							  scorers belong to 3D Objects Counter+, not here.
							-->
							<minimizeJar>true</minimizeJar>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<configuration>
					<licenseResolver>${project.baseUri}src/license</licenseResolver>
					<roots>
						<root>src/main</root>
						<root>src/test</root>
					</roots>
					<includes>
						<include>**/*.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
